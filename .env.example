# =============================================================================
# CloudScale — Environment Variable Reference (.env.example)
#
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control — it is in .gitignore.
#
# These variables are used by backend/index.mjs when running the Lambda
# locally (e.g. with `sam local invoke`) or when set as Lambda Environment
# Variables in the AWS Console.
# =============================================================================

# AWS region where the CloudScale infrastructure lives.
# Default: ap-south-1
AWS_REGION=ap-south-1

# Name of the Auto Scaling Group to monitor.
# Default: CloudScale-ASG
ASG_NAME=CloudScale-ASG

# Name of the Target Group to monitor.
# Default: CloudScale-TG
TG_NAME=CloudScale-TG

# Plain name of the Application Load Balancer (not the ARN).
# The Lambda resolves the ARN at runtime via DescribeLoadBalancers.
# Default: CloudScale-ALB
ALB_NAME=CloudScale-ALB

# CloudWatch: EC2 CPU metric resolution.
# Period in seconds (300 = 5 min for basic monitoring, 60 = 1 min for detailed).
# Default: 300
CPU_PERIOD_SECONDS=300

# CloudWatch: window of EC2 CPU history to return (in minutes).
# Default: 180  (3 hours)
CPU_WINDOW_MINUTES=180

# CloudWatch: ALB metric sampling period in seconds.
# Default: 60
ALB_PERIOD_SECONDS=60

# CloudWatch: window of ALB metric history to return (in minutes).
# Default: 60  (1 hour)
ALB_WINDOW_MINUTES=60

# Maximum number of recent Auto Scaling activities to return.
# Default: 10
SCALING_ACTIVITY_MAX=10

# Server-side cache TTL in milliseconds.
# Prevents multiple open browser tabs from multiplying AWS API calls.
# Default: 15000  (15 seconds)
CACHE_TTL_MS=15000
